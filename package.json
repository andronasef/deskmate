{
  "name": "deskmate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "og": "remotion still trailer/index.ts Og public/og.png",
    "trailer:studio": "remotion studio trailer/index.ts",
    "trailer:screen": "remotion render trailer/index.ts ScreenContent public/screen.mp4 --codec=h264 --jpeg-quality=95 --scale=2",
    "trailer:desktop": "remotion render trailer/index.ts DesktopContent public/desktop.mp4 --codec=h264 --jpeg-quality=95",
    "trailer:render": "remotion render trailer/index.ts PhoneTrailer out/deskmate-phone.mp4 --gl=angle --concurrency=2 --codec=h264 --crf=16"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "1.29.x",
    "lz-string": "^1.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "^2.2.4",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/fiber": "^9.7.0",
    "@remotion/cli": "^4.0.521",
    "@remotion/media": "^4.0.521",
    "@remotion/three": "^4.0.521",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^27.4.0",
    "mediabunny": "^1.55.7",
    "prettier": "3.9.0",
    "remotion": "^4.0.521",
    "three": "^0.185.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
